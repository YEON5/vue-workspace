{
  "name": "@ui/style",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./dist/style.css": "./dist/style.css",
    "./tokens-config": "./src/tokens-config.js"
  },
  "scripts": {
    "tokens:convert": "node scripts/convert-tokens.js",
    "generate:tokens": "node scripts/generate-tokens.js",
    "tokens": "npm run tokens:convert && npm run generate:tokens",
    "dev": "concurrently \"node scripts/watch-tokens.js\" \"tailwindcss -i ./src/style.css -o ./dist/style.css --watch\"",
    "build": "npm run tokens && tailwindcss -i ./src/style.css -o ./dist/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "chokidar": "^3.6.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.1.0",
    "tailwindcss-animate": "^1.0.7"
  }
}